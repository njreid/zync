# Copy this file to key.properties for local release builds.
# Never commit key.properties or the keystore.

storeFile=/absolute/path/to/zync-release.jks
storePassword=change-me
keyAlias=zync-release
keyPassword=change-me

# Cloudflare Access Service Token (see
# docs/superpowers/plans/2026-09-04-shared-host-cloudflare-zero-trust.md Task 5/6).
CF_ACCESS_CLIENT_ID=your-service-token-client-id
CF_ACCESS_CLIENT_SECRET=your-service-token-client-secret
